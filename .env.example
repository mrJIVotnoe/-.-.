# ========================================================
# JIV FLEET PLATFORM - ENVIRONMENT CONFIGURATION (.env)
# ========================================================

# App Runtime & Network Binding
NODE_ENV=production
APP_MODE=demo # Options: demo | local | staging | production
PORT=3000
HOST=0.0.0.0
APP_URL=https://fleet.your-domain.ru

# AI Assistant Integration (Gemini 2.5 Flash / Pro)
GEMINI_API_KEY=your_gemini_api_key_here

# Persistence & Database Options (Optional for initial bare-metal, required for scale)
# Leave empty for local storage / embedded persistence engine
DATABASE_URL=postgresql://jiv_user:jiv_secret_pass@db:5432/jiv_fleet_db
REDIS_URL=redis://redis:6379

# Telegram Bot & Mini App Configuration
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ
TELEGRAM_BOT_USERNAME=JivVladivostokFleetBot
TELEGRAM_WEBHOOK_URL=https://fleet.your-domain.ru/api/telegram/webhook

# WeChat Mini App & WeChat Pay Configuration (微信小程序 & 微信支付)
WECHAT_APP_ID=wx1234567890abcdef
WECHAT_APP_SECRET=your_wechat_app_secret_here
WECHAT_MCH_ID=1600000000
WECHAT_MCH_KEY=your_wechat_mch_partner_key_here
WECHAT_TOKEN=jiv_vladivostok_wechat_token

# E-mail OTP Auth Engine (Yandex Mail / Mail.ru SMTP)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=auth@vladivostok-fleet.ru
SMTP_PASS=your_smtp_app_password
SMTP_FROM="JIV Fleet Auth <auth@vladivostok-fleet.ru>"

# Cloud Provider & Deployment Metadata
CLOUD_PROVIDER=Bare-Metal / Self-Hosted
# For Yandex.Cloud Migration:
YANDEX_CLOUD_FOLDER_ID=b1g...
YANDEX_REGISTRY_ID=crp...
# For Sber Cloud.ru Migration:
SBER_CLOUD_PROJECT_ID=sber_proj_...
